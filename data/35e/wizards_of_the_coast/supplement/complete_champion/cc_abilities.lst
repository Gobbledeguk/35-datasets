Remove Domain for Devotion Feat I	BONUS:ABILITYPOOL|Domain Feat|1	COST:0	BONUS:DOMAIN|NUMBER|-1	CATEGORY:Internal	TYPE:MiscOptions.DomainRemoval	!PREABILITY:1,CATEGORY=Internal,TYPE.DomainRemoval,[Remove Domain for Devotion Feat I]	
Remove Domain for Devotion Feat II	BONUS:ABILITYPOOL|Domain Feat|2	COST:0	BONUS:DOMAIN|NUMBER|-2	CATEGORY:Internal	TYPE:MiscOptions.DomainRemoval	!PREABILITY:1,CATEGORY=Internal,TYPE.DomainRemoval,[Remove Domain for Devotion Feat II]	
Remove Domain for Devotion Feat III	BONUS:ABILITYPOOL|Domain Feat|3	COST:0	BONUS:DOMAIN|NUMBER|-3	CATEGORY:Internal	TYPE:MiscOptions.DomainRemoval	!PREABILITY:1,CATEGORY=Internal,TYPE.DomainRemoval,[Remove Domain for Devotion Feat III]	

