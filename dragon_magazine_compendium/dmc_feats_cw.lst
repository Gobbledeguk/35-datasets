CATEGORY=FEAT|Curse of Sloth.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Curse of the Softened Blade.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Curse of the Stricken.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Empower Curse.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Extend Curse.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Extra Curse.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Foe of the Unlucky.MOD	PREVARGTEQ:HexbladesCurseTimes,1
CATEGORY=FEAT|Black Panda Mastery II.MOD	PREABILITY:1,CATEGORY=FEAT,Extra Stunning
CATEGORY=FEAT|Temerad Mastery II.MOD	PREABILITY:1,CATEGORY=FEAT,Extra Stunning
